{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/ai-assistant-vs-virtual-assistant-australia.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/ai-assistant-vs-virtual-assistant-australia",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/ai-business-assistant-australia.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/ai-business-assistant-australia",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/ai-invoice-management-small-business.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/ai-invoice-management-small-business",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/_retired/:path*",
      "destination": "/blog",
      "permanent": true
    }
  ]
}
